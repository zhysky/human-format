{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": false,
    "maxSize": 16777216
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "useEditorconfig": false
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded",
      "attributePosition": "multiline"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": false,
    "formatter": {
      "enabled": false,
      "attributePosition": "multiline",
      "indentScriptAndStyle": false,
      "whitespaceSensitivity": "css"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  }
}
